<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Conteúdo Rolável Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Fundo Superior Azul -->
            <View
                android:id="@+id/headerBg"
                android:layout_width="0dp"
                android:layout_height="250dp"
                android:background="#007BFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Ícone de Menu -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@android:color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Ícones do Topo -->
            <ImageView
                android:id="@+id/btnCalendar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#22FFFFFF"
                android:padding="8dp"
                android:src="@drawable/baseline_calendar_month_24"
                app:tint="@android:color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#22FFFFFF"
                android:padding="8dp"
                android:src="@drawable/baseline_notifications_24"
                app:tint="@android:color/white"
                app:layout_constraintEnd_toStartOf="@+id/btnCalendar"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título da Tela -->
            <ImageView
                android:id="@+id/imgTitleGroup"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/baseline_groups_24"
                app:tint="@android:color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnMenu" />

            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Meus alunos"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/imgTitleGroup"
                app:layout_constraintStart_toEndOf="@+id/imgTitleGroup"
                app:layout_constraintTop_toTopOf="@+id/imgTitleGroup" />

            <TextView
                android:id="@+id/txtHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:text="Acompanhe a evolução de cada aluno."
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgTitleGroup" />

            <!-- Cartões de Estatísticas -->
            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtHeaderSub">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:elevation="2dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginBottom="4dp" android:src="@drawable/baseline_groups_24" app:tint="#007BFF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ativos" android:textColor="#6C757D" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:elevation="2dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginBottom="4dp" android:src="@drawable/baseline_bar_chart_24" app:tint="#28A745"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evoluindo" android:textColor="#6C757D" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:elevation="2dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginBottom="4dp" android:src="@drawable/baseline_groups_24" app:tint="#FD7E14"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Novos" android:textColor="#6C757D" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:elevation="2dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginBottom="4dp" android:src="@drawable/baseline_groups_24" app:tint="#DC3545"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inativos" android:textColor="#6C757D" android:textSize="11sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Barra de Pesquisa -->
            <EditText
                android:id="@+id/edtSearchStudent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input_rounded"
                android:hint="🔍 Buscar aluno por nome..."
                android:paddingStart="16dp"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutStats" />

            <!-- Abas de Filtro -->
            <LinearLayout
                android:id="@+id/layoutFilters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edtSearchStudent">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#007BFF"
                    android:text="Todos"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:backgroundTint="@android:color/white"
                    android:text="Ativos"
                    android:textColor="#6C757D"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:backgroundTint="@android:color/white"
                    android:text="Inativos"
                    android:textColor="#6C757D"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- RECYCLERVIEW (Onde os itens do student_item vão aparecer) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStudents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_student"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutFilters" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- BARRA DE NAVEGAÇÃO INFERIOR FIXA (Fora do ScrollView) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_bar_chart_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Início" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_groups_24" app:tint="#007BFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Alunos" android:textColor="#007BFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_fitness_center_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Treinos" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_calendar_month_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Agenda" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_person_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Perfil" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>