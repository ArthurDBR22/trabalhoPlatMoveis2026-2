<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Conteúdo Rolável Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Fundo Superior Azul -->
            <View
                android:id="@+id/headerBg"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:background="#007BFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Botão Voltar -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título da Tela -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Acompanhamento do aluno"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                app:layout_constraintStart_toEndOf="@+id/btnBack"
                app:layout_constraintTop_toTopOf="@+id/btnBack" />

            <!-- Ícones do Topo -->
            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#22FFFFFF"
                android:padding="8dp"
                android:src="@drawable/baseline_star_24"
                app:tint="@android:color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#22FFFFFF"
                android:padding="8dp"
                android:src="@drawable/baseline_notifications_24"
                app:tint="@android:color/white"
                app:layout_constraintEnd_toStartOf="@+id/btnMore"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/txtSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="6dp"
                android:text="Veja a evolução, treinos e resultados."
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnBack" />

            <!-- Cartão do Perfil do Aluno -->
            <LinearLayout
                android:id="@+id/cardStudentProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_rounded"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtSub">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Foto do Aluno -->
                    <ImageView
                        android:id="@+id/imgStudentPhoto"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_rounded"
                        android:scaleType="centerCrop"
                        android:src="@drawable/baseline_groups_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtStudentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mariana Costa"
                            android:textColor="#0A192F"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="👤 22 anos  •  ⚥ Feminino"
                            android:textColor="#6C757D"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="📅 Membro desde: 12/03/2025"
                            android:textColor="#6C757D"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Status Ativo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="#E8F8F0"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Ativo"
                        android:textColor="#28A745"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botão Enviar Mensagem -->
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#007BFF"
                    android:text="💬 Enviar mensagem"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Abas Superiores -->
            <LinearLayout
                android:id="@+id/layoutTabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardStudentProfile">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#007BFF"
                    android:text="Visão geral"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@android:color/white"
                    android:text="Treinos"
                    android:textAllCaps="false"
                    android:textColor="#6C757D"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- 3 Cartões de Estatísticas -->
            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutTabs">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/baseline_fitness_center_24" app:tint="#007BFF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textColor="#0A192F" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Realizados" android:textColor="#6C757D" android:textSize="9sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/baseline_calendar_month_24" app:tint="#FD7E14"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10h 30m" android:textColor="#0A192F" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tempo total" android:textColor="#6C757D" android:textSize="9sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/baseline_bar_chart_24" app:tint="#28A745"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80%" android:textColor="#0A192F" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frequência" android:textColor="#6C757D" android:textSize="9sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- SEÇÃO: EVOLUÇÃO NO TEMPO (Gráfico de Peso) -->
            <TextView
                android:id="@+id/txtEvolucaoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:text="Evolução no tempo"
                android:textColor="#0A192F"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutStats" />

            <LinearLayout
                android:id="@+id/cardChart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_rounded"
                android:orientation="vertical"
                android:padding="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtEvolucaoTitle">

                <!-- Botão de Filtro (Peso kg) -->
                <Button
                    android:layout_width="110dp"
                    android:layout_height="32dp"
                    android:backgroundTint="#007BFF"
                    android:text="Peso (kg)"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />

                <!-- Área simulada do Gráfico com Balão de Destaque -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="8dp">

                    <!-- Linha e marcação de Exemplo -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_centerVertical="true"
                        android:background="#007BFF" />

                    <!-- Balão de Destaque atual -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_input_rounded"
                        android:backgroundTint="@android:color/white"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="62 kg"
                            android:textColor="#0A192F"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15/09/2025"
                            android:textColor="#6C757D"
                            android:textSize="9sp" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Legenda de Meses -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:paddingTop="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Jun" android:textColor="#6C757D" android:textSize="10sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Jul" android:textColor="#6C757D" android:textSize="10sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Ago" android:textColor="#6C757D" android:textSize="10sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Set" android:textColor="#6C757D" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Seção: Último treino -->
            <TextView
                android:id="@+id/txtLastWorkoutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:text="Último treino"
                android:textColor="#0A192F"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardChart" />

            <LinearLayout
                android:id="@+id/cardLastWorkout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtLastWorkoutTitle">

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_rounded"
                    android:src="@drawable/baseline_fitness_center_24"
                    app:tint="#007BFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino de Pernas"
                        android:textColor="#0A192F"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="📅 12/09/2025 • ⏱️ 50 min"
                        android:textColor="#6C757D"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Seção: Observações (Alterado para EditText editável e vazio) -->
            <TextView
                android:id="@+id/txtObsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:text="Observações"
                android:textColor="#0A192F"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardLastWorkout" />

            <EditText
                android:id="@+id/edtObservations"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_rounded"
                android:gravity="top|start"
                android:hint="Escreva aqui anotações ou observações sobre o aluno..."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="#0A192F"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtObsTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- BARRA DE NAVEGAÇÃO INFERIOR FIXA -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_bar_chart_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Início" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_groups_24" app:tint="#007BFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Alunos" android:textColor="#007BFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_fitness_center_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Treinos" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_calendar_month_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Agenda" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/baseline_star_24" app:tint="#6C757D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Perfil" android:textColor="#6C757D" android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>