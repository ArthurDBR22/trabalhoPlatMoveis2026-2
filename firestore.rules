rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isInstructor() {
      return hasRole('INSTRUCTOR') || hasRole('ADMIN');
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    // ==========================================
    // PERFIL DE USUÁRIOS
    // ==========================================
    match /users/{userId} {
      // Usuário pode ler o próprio perfil; Instrutores/Admins podem ler perfis de alunos
      allow read: if isOwner(userId) || isInstructor();

      // Criação de perfil inicial (o próprio usuário ou admin cria o documento inicial)
      // Nota de Produção: Em produção, restrinja ADMIN/INSTRUCTOR via Cloud Functions / Custom Claims.
      allow create: if (isOwner(userId) && request.resource.data.role in ['STUDENT', 'INSTRUCTOR', 'ADMIN']) || isAdmin();

      // Atualização: Usuário comum não pode alterar seu próprio role; Admin pode alterar tudo
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();

      allow delete: if isAdmin();

      // ==========================================
      // FICHAS DE TREINO E EXERCÍCIOS
      // ==========================================
      match /workouts/{workoutId} {
        // Aluno lê suas fichas; Instrutores/Admins lêem e gerenciam as fichas
        allow read: if isOwner(userId) || isInstructor();
        allow create, update, delete: if isInstructor();

        match /exercises/{exerciseId} {
          allow read: if isOwner(userId) || isInstructor();
          allow create, update, delete: if isInstructor();
        }
      }

      // ==========================================
      // HISTÓRICO DE SESSÕES EXECUTADAS
      // ==========================================
      match /workout_sessions/{sessionId} {
        allow read: if isOwner(userId) || isInstructor();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId) || isInstructor();
      }

      // ==========================================
      // AVALIAÇÕES FÍSICAS E MEDIDAS
      // ==========================================
      match /assessments/{assessmentId} {
        allow read: if isOwner(userId) || isInstructor();
        allow create, update: if isInstructor();
        allow delete: if isAdmin();
      }

      match /body_measurements/{measurementId} {
        allow read: if isOwner(userId) || isInstructor();
        allow create, update: if isOwner(userId) || isInstructor();
        allow delete: if isInstructor();
      }

      // ==========================================
      // METAS DO ALUNO
      // ==========================================
      match /goals/{goalId} {
        allow read: if isOwner(userId) || isInstructor();
        allow create, update: if isOwner(userId) || isInstructor();
        allow delete: if isOwner(userId) || isInstructor();
      }

      // ==========================================
      // DIÁRIO DE NUTRIÇÃO E HIDRATAÇÃO
      // ==========================================
      match /daily_logs/{dateKey} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // BIBLIOTECA GLOBAL DE EXERCÍCIOS
    // ==========================================
    match /exercise_library/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isInstructor();
    }

    // ==========================================
    // FEED SOCIAL DA ACADEMIA
    // ==========================================
    match /posts/{postId} {
      allow read: if isAuthenticated() && (resource.data.status == 'ACTIVE' || isInstructor());
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isInstructor());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isInstructor());
      }
    }
  }
}
